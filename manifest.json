{
  "manifest_version": 3,
  "name": "GPlusTab",
  "version": "2.1",
  "description": "Beautiful photos hand-selected by Ade Oshineye for your New Tab.",
  "chrome_url_overrides": {
    "newtab": "flickrset.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.flickr.com/"
  ]}
